{
  "name": "flipkart-bulk-management",
  "version": "1.0.0",
  "description": "Flipkart Supplier Automation, Bulk Inventory and Single Catalog Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build:frontend": "npm run build --prefix frontend",
    "install:all": "npm install && npm install --prefix frontend && npx playwright install chromium"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "playwright": "^1.44.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "socket.io": "^4.7.5"
  },
  "keywords": [
    "flipkart",
    "bulk-management",
    "automation",
    "playwright",
    "inventory",
    "catalog"
  ],
  "author": "",
  "license": "ISC"
}
